        }
        flag --peer-node-id help="Expected canonical peer node ID" required=#true display_order=1 {
            arg <PEER_NODE_ID>
        }
        flag --script help="Script name as the Performer declared it. A path is not accepted: the Performer resolves the name against what it published, and a Cue never carries a location" required=#true display_order=2 {
            arg <SCRIPT>
        }
        flag --reason help="Why this is being asked for. Recorded in the Performer's audit trail" required=#true display_order=3 {
            arg <REASON>
        }
        flag --wait-seconds help="How long to stay on the session waiting for the `run-completed` Signal" display_order=4 default="120" {
            long_help #"""
How long to stay on the session waiting for the `run-completed` Signal.

The outcome is read on the connection this dial already opened, because a Performer that holds a standing session with this Conductor refuses the dial outright — the configuration that would deliver the Signal is the one in which the Cue could not be sent. `0` dispatches and returns immediately; the run still happens and still reports.
"""#
            arg <WAIT_SECONDS>
        }
        flag --direct help="Dial the peer from this process instead of asking the running service" display_order=5 default="false" {
            long_help #"""
Dial the peer from this process instead of asking the running service.

The service is preferred because it is the only thing that can reach a peer this node already has a session with. Use this for a peer there is no standing session with, or when no service is running.
"""#
        }
        flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
