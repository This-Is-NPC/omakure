name omakure
bin omakure
version "0.3.0"
about "Omakure - CLI for running and scheduling automation scripts"
long_about #"""
Omakure - CLI for running and scheduling automation scripts.

Run `omakure` with no arguments to print this help.

CLI surfaces:{n} run <SCRIPT>          execute a script directly{n} queue add <SCRIPT>    push a job; `queue worker` drains it{n} serve                 run the cron scheduler daemon{n} history list|show     query past runs (SQLite-backed){n} scripts|describe|search   inspect the script catalogue

AI integration: pass `--json` on supported subcommands to emit a `{ ok, data, error, schema_version }` envelope; run `omakure help-ai` for the full machine-readable capability surface.
"""#
unknown_flags error
args_override_self #false
usage "Usage: omakure [OPTIONS] [COMMAND]"
flag --scripts-dir help="Scripts directory override" global=#true {
    arg <SCRIPTS_DIR>
}
flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
    long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
}
complete scripts_dir type=path
cmd run display_order=2 disable_version_flag=#true args_override_self=#false help="Run a script directly" unknown_flags=value {
    flag --actor help="Actor tag recorded in the run history (default: `human`)" display_order=0 default=human {
        arg <ACTOR>
    }
    flag --reason help="Optional free-form reason recorded in the run history" display_order=1 {
        arg <REASON>
    }
    flag --run-id help="Caller-provided run id; otherwise a fresh id is generated" display_order=2 {
        arg <RUN_ID>
    }
    flag --parent-run-id help="Optional parent run id, for chained agent workflows" display_order=3 {
        arg <PARENT_RUN_ID>
    }
    flag --no-prompt help="Fail with a structured error if any required field is missing instead of attempting to read stdin / open a TTY. Implied by `--json`" display_order=4 default="false"
    flag --env-file help="Path to an env file whose `KEY=value` pairs are injected into the script process for this run only. Values override the managed active env for the same key, but omakure-reserved vars (`OMAKURE_RUN_ID`, `OMAKURE_SCRIPTS_DIR`) always win. A missing or unreadable path is a hard error" display_order=5 {
        long_help #"""
Path to an env file whose `KEY=value` pairs are injected into the script process for this run only. Values override the managed active env for the same key, but omakure-reserved vars (`OMAKURE_RUN_ID`, `OMAKURE_SCRIPTS_DIR`) always win. A missing or unreadable path is a hard error.

Example: `omakure run deploy --env-file ./.venv.env -- --target prod`
"""#
        arg <PATH>
    }
    flag --secret help="Direct secret field input as `FIELD=value`. The value is supplied to secret schema fields for this run and is redacted from stored args" var=#true display_order=6 {
        arg "<FIELD=VALUE>…" var=#true
    }
    flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    arg <SCRIPT> help="Script name or path"
    arg "[ARGS]…" help="Arguments forwarded to the script" required=#false double_dash=automatic var=#true var_min=1
    complete path type=path
    complete scripts_dir type=path
}
