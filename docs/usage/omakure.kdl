cmd config display_order=17 disable_version_flag=#true args_override_self=#false help="Show resolved paths and environment diagnostics" unknown_flags=error {
    long_help #"""
Show resolved paths and environment diagnostics

Prints the resolved binary path, omakure version, workspace root, scripts root, `.omakure/` directory, history directory, workspace config file, environments directory, active environment, and any known env overrides (`OMAKURE_SCRIPTS_DIR`, `OMAKURE_REPO`, `OVERTURE_*`, `CLOUD_MGMT_*`, `REPO`, `VERSION`). Pass `--json` for the machine-readable envelope.
"""#
    flag --scripts-dir help="Scripts directory override" global=#true {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete scripts_dir type=path
}
cmd update display_order=18 disable_version_flag=#true args_override_self=#false help="Update omakure from GitHub releases" unknown_flags=error {
    long_help #"""
Update omakure from GitHub releases

Downloads the release archive for the current OS/arch and replaces the running binary in place. Also copies any scripts missing from your local scripts directory from the source archive of the target version — existing files are never overwritten. `--repo` defaults to `$OMAKURE_REPO` / `$OVERTURE_REPO` / `$CLOUD_MGMT_REPO` / `$REPO` / `This-Is-NPC/omakure`; `--version` defaults to `$VERSION` or the latest GitHub release.
"""#
    flag --repo help="GitHub repository (`owner/name`). Defaults to `$OMAKURE_REPO` / `$OVERTURE_REPO` / `$CLOUD_MGMT_REPO` / `$REPO` / `This-Is-NPC/omakure`" display_order=0 {
        arg <REPO>
    }
    flag --version help="Release tag to install (e.g. `v0.1.9`). Defaults to `$VERSION` or the latest GitHub release for the configured repo" display_order=1 {
        arg <VERSION>
    }
    flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete scripts_dir type=path
}
cmd uninstall display_order=19 disable_version_flag=#true args_override_self=#false help="Remove the omakure binary (optionally wipe the scripts workspace)" unknown_flags=error {
    long_help #"""
Remove the omakure binary (optionally wipe the scripts workspace)

Deletes the currently running binary from its install directory (on Windows also strips the install path from the user `PATH`). With `--scripts`, PERMANENTLY deletes the entire scripts workspace, including `.omakure/` (envs, daemon files), `.history/`, schedules) and every script file — use with care and have backups.
"""#
    flag --scripts help="Also delete the scripts workspace directory (runs.sqlite, history, schedules, and every user script). Destructive" default="false"
    flag --scripts-dir help="Scripts directory override" global=#true {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete scripts_dir type=path
}
cmd completion display_order=20 disable_version_flag=#true args_override_self=#false help="Generate shell completion script for the given shell" unknown_flags=error {
    long_help #"""
Generate shell completion script for the given shell

Writes the completion script to stdout. Quick install examples:{n} bash: `omakure completion bash >> ~/.bashrc`{n} zsh:  `omakure completion zsh  > ~/.zfunc/_omakure` (ensure `~/.zfunc` is on `$fpath`){n} fish: `omakure completion fish > ~/.config/fish/completions/omakure.fish`{n} pwsh: `omakure completion pwsh | Out-String | Invoke-Expression`

For a one-shot session pipe into your current shell: `eval "$(omakure completion zsh)"`.
"""#
    flag --scripts-dir help="Scripts directory override" global=#true {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    arg <SHELL> help="Shell to generate completions for" {
        choices bash zsh fish pwsh
    }
    complete scripts_dir type=path
}
cmd serve display_order=21 disable_version_flag=#true args_override_self=#false help="Run the cron scheduler daemon for scripts declaring a `Schedule` block" unknown_flags=error {
    long_help #"""
Run the cron scheduler daemon for scripts declaring a `Schedule` block

Running `omakure serve` with no flags starts the scheduler in the foreground with an in-process worker; `-d`/`--detach` daemonizes (Unix) and `--stop` terminates a running daemon.

The scheduler rescans the workspace every 5 seconds, parses each script's `Schedule` block, and enqueues a run when the cron expression is due. Fires are SKIPPED when a previous run with the same `cron_schedule_id` is still `queued` or `running`, so long-lived overlapping jobs never stack up.

Paths (per workspace):{n} PID file: `<workspace>/.omakure/daemon.pid`{n} Log:      `<workspace>/.omakure/daemon.log`

`--install`/`--uninstall`/`--status` manage a per-workspace systemd user unit so the daemon survives reboots (Linux only); after install tail with `journalctl --user -u <unit> -f`.

By default an in-process worker is spawned so scheduled rows execute without a separate process. Pass `--no-worker` when you run `omakure queue worker` elsewhere.
"""#
    flag "-d --detach" help="Run the scheduler as a detached background daemon (Unix only)" display_order=0 default="false" {
        conflicts "--stop" "--install" "--uninstall" "--status"
    }
    flag --stop help="Stop a running daemon (reads `.omakure/daemon.pid` and sends SIGTERM)" display_order=1 default="false" {
        conflicts "--install" "--uninstall" "--status"
    }
    flag --install help="Install a systemd user service that runs `omakure serve` for the current workspace and survives reboots (Linux only)" display_order=2 default="false" {
        conflicts "--uninstall" "--status"
    }
    flag --uninstall help="Disable and remove the systemd user service for the current workspace (Linux only)" conflicts=--status display_order=3 default="false"
    flag --status help="Print the systemd user service status for the current workspace (Linux only)" display_order=4 default="false"
    flag --no-worker help="Do not spawn the in-process worker. Use when you already run `omakure queue worker` elsewhere" display_order=5 default="false"
    flag --concurrency help="Number of worker threads for the in-process worker (default 1)" display_order=6 default="1" {
        arg <CONCURRENCY>
    }
    flag --once help="Test convenience: run a single scheduler tick, enqueue whatever is due, then exit. Hidden from --help. Used by integration tests" hide=#true display_order=7 default="false"
    flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete scripts_dir type=path
}
