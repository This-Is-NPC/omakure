    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    cmd generate display_order=0 disable_version_flag=#true args_override_self=#false help="Generate a plaintext token, Argon2id hash, and TOML entry" unknown_flags=error {
        flag --id help="Stable token id (logged/audited; never the secret)" required=#true display_order=0 {
            arg <ID>
        }
        flag --scope help="Scope to grant (repeatable), e.g. runs:read, scripts:read, *" required=#true var=#true display_order=1 {
            arg <SCOPES>… var=#true
        }
        flag --append help="Append the TOML entry to this tokens file (requires `--confirmed`)" display_order=2 {
            arg <APPEND>
        }
        flag --confirmed help="Confirm a destructive/automated `--append`" display_order=3 default="false"
        flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
            arg <SCRIPTS_DIR>
        }
        flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
            long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
        }
        complete append type=path
        complete scripts_dir type=path
    }
    complete scripts_dir type=path
}
cmd api display_order=11 disable_version_flag=#true args_override_self=#false help="Run the internal HTTP management API" unknown_flags=error {
    long_help #"""
Run the internal HTTP management API

Starts a loopback-only HTTP API by default at `127.0.0.1:7878`. All endpoints except `/v1/health` and `/v1/ready` require `Authorization: Bearer <token>`. Prefer `--tokens-file` / `OMAKURE_TOKENS_FILE` (per-token Argon2id scopes). Legacy `OMAKURE_API_TOKEN` still works when no tokens file is configured. Binding to non-loopback addresses requires `--allow-non-loopback`.
"""#
    flag --bind help="Address to bind the HTTP API server to" display_order=0 default="127.0.0.1:7878" {
        arg <BIND>
    }
    flag --allow-non-loopback help="Explicitly allow the HTTP API to bind to non-loopback addresses" display_order=1 default="false"
    flag --policy help="Deploy-only policy.toml (route groups + auth/node-service defaults). Overrides `OMAKURE_POLICY_FILE`. Separate from workspace omakure.toml" display_order=2 {
        arg <POLICY>
    }
    flag --tokens-file help="Multi-token TOML file (Argon2id hashes + per-token scopes). Overrides `OMAKURE_TOKENS_FILE`. When set, process-wide `--capability` is ignored; scopes come from each token" display_order=3 {
        arg <TOKENS_FILE>
    }
    flag --capability help="API capability to grant in legacy single-token mode (`OMAKURE_API_TOKEN`). Repeatable. Ignored when `--tokens-file` is set. Supported: config:read, scripts:read, env:read / envs:read, env:write / envs:write, env:activate / envs:activate, env:use / envs:use, secrets:use, secrets:read-metadata, credentials:use, runs:read, runs:write / runs:enqueue, batteries:read, batteries:write, admin:status, all. Node management uses narrow node:read, node:write, and trust:write capabilities. `all` grants every route capability but does not bypass `--secret-ref` (pass `--secret-ref '*'` for unrestricted refs)" var=#true display_order=4 {
        arg <CAPABILITIES>… var=#true
    }
    flag --secret-ref help="Allowed secret provider ref for secrets:use / credentials:use, e.g. secret://prod/token or secret://prod/*; repeatable. Empty denies provider refs" var=#true display_order=5 {
        arg <SECRET_REFS>… var=#true
    }
    flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete policy type=path
    complete tokens_file type=path
    complete scripts_dir type=path
}
cmd trace display_order=12 disable_version_flag=#true args_override_self=#false help="Run the machine-owned node service (HTTP API + optional workers + scheduler)" unknown_flags=error {
    long_help #"""
Run the machine-owned node service (HTTP API + optional workers + scheduler)

Starts the HTTP management API and optionally embeds queue workers and the existing schedule scanner in one process. Use `--workers 0 --no-scheduler` for API-only (same auth surface as `omakure api`). `GET /v1/ready` is unauthenticated and returns minimal readiness. `GET /v1/admin/status` (scope `admin:status`) exposes readiness details and token reload health without secrets. Authenticated requests emit `omakure.http_audit` lines with `token_id` (Authorization redacted). SIGTERM/SIGINT stops HTTP first, then scheduling/claiming, then drains workers. Append a structured trace event from inside a running script
"""#
    flag --level help="Level (debug, info, warn, error). Defaults to `info`" display_order=0 default=info {
        arg <LEVEL>
    }
    flag --data help="Optional structured payload (must parse as JSON)" display_order=1 {
        arg <DATA>
    }
    flag --scripts-dir help="Scripts directory override" global=#true display_order=0 {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true display_order=1 default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    arg <MESSAGE> help="Trace message"
    complete scripts_dir type=path
}
cmd help-ai display_order=13 disable_version_flag=#true args_override_self=#false help="Print the AI capability surface as JSON" unknown_flags=error {
    long_help #"""
Print the AI capability surface as JSON

Always emits JSON (regardless of `--json`). The envelope uses the standard `{ ok, data, error, schema_version }` shape.{n} {n} `data` contains:{n} trust_model   — how omakure treats AI callers{n} error_codes   — the registered stable error code strings{n} envelope      — a self-describing shape hint{n} verbs         — AI-relevant subcommands with flags and nested subcommands (pulled from clap metadata, so it cannot drift from `--help`){n} data_shapes   — concrete examples for `run`, `history_list`, `history_show`, and `config`

Agents can cache the payload per binary version (`--version`).
"""#
    flag --scripts-dir help="Scripts directory override" global=#true {
        arg <SCRIPTS_DIR>
    }
    flag --json help="Emit machine-readable JSON output for AI-facing subcommands" global=#true default="false" {
        long_help #"""
Emit machine-readable JSON output for AI-facing subcommands.

When set, supported subcommands print exactly one JSON envelope `{ ok, data, error, schema_version }` on stdout instead of their human-readable form. Subcommands that do not support JSON ignore this flag.
"""#
    }
    complete scripts_dir type=path
}
