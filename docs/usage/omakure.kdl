            arg <DIRECT_BIND>
        }
        flag --allow-non-loopback help="Explicitly allow binding to non-loopback addresses" display_order=2 default="false"
        flag --allow-non-loopback-direct help="Explicitly allow the direct transport to bind to non-loopback addresses" display_order=3 default="false"
        flag --policy help="Deploy-only policy.toml. Same as `omakure api --policy`" display_order=4 {
            arg <POLICY>
        }
        flag --workers help="Number of embedded queue workers. `0` means API-only (no claiming)" display_order=5 {
            arg <WORKERS>
        }
        flag --scheduler help="Explicitly enable the in-process schedule scanner" display_order=6 default="false"
