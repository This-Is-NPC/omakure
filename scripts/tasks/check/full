#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
root="$(cd -- "$root" && pwd -P)"
cd "$root"
export MISE_PROJECT_ROOT="$root"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'check:full: required command is missing: %s\n' "$1" >&2
        exit 1
    }
}

if [[ "$(uname -s)" != Linux ]]; then
    printf 'check:full: the complete local suite requires Linux\n' >&2
    exit 1
fi
for command in cargo docker jq python3 sqlite3 timeout; do
    require_command "$command"
done
timeout_version="$(timeout --version 2>&1 || true)"
[[ "$timeout_version" == *"GNU coreutils"* ]] || {
    printf 'check:full: GNU timeout is required for bounded checks\n' >&2
    exit 1
}
docker compose version >/dev/null 2>&1 || {
    printf 'check:full: Docker Compose is required\n' >&2
    exit 1
}

"$root/scripts/tasks/check/shared"
printf 'check:full: bounded formatting and Clippy\n'
timeout --foreground --kill-after=10s 15m "$root/scripts/mise/lint"

printf 'check:full: all-target tests\n'
timeout --foreground --kill-after=10s 30m cargo test --all-targets --locked

printf 'check:full: bounded development service smoke\n'
timeout --foreground --kill-after=10s 15m "$root/scripts/tasks/dev/smoke"

printf 'check:full: bounded usage and catalog artifact checks\n'
timeout --foreground --kill-after=10s 5m "$root/scripts/tasks/usage-kdl" --check
timeout --foreground --kill-after=10s 5m "$root/scripts/tasks/usage-docs" --check
timeout --foreground --kill-after=10s 5m "$root/scripts/tasks/operation-catalog" --check

printf 'check:full: deterministic coverage\n'
timeout --foreground --kill-after=10s 45m "$root/scripts/tasks/coverage"

printf 'check:full: complexity calibration\n'
"$root/scripts/tasks/complexity-setup"
"$root/scripts/tasks/complexity-test"
mkdir -p target/quality/complexity-evidence
"$root/scripts/tasks/complexity-report" --source-root . \
    --output target/quality/complexity-report-a.json
"$root/scripts/tasks/complexity-report" --source-root . \
    --output target/quality/complexity-report-b.json
cmp --silent target/quality/complexity-report-a.json \
    target/quality/complexity-report-b.json
"$root/scripts/tasks/complexity-gate" \
    --report target/quality/complexity-report-a.json \
    --repeat-report target/quality/complexity-report-b.json \
    --baseline quality/complexity/baseline.json \
    --exceptions quality/complexity/exceptions.json \
    --output target/quality/complexity-evidence/gate.json
"$root/scripts/tasks/complexity-soak-audit" \
    --directory target/quality/complexity-evidence

printf 'check:full: release and package checks\n'
timeout --foreground --kill-after=10s 30m cargo build --release --bin omakure --locked
"$root/scripts/release/package-release.sh" \
    target/release/omakure dist/omakure.tar.gz

printf 'check:full: Fedora VM static policy checks\n'
"$root/scripts/tasks/cert/vm-static"

printf 'check:full: Docker smoke\n'
"$root/scripts/tasks/cert/docker-smoke"

printf 'check:full: transport certification\n'
"$root/scripts/tasks/cert/transport"
printf 'check:full: Health certification\n'
"$root/scripts/tasks/cert/health"
printf 'check:full: Health cleanup verification\n'
"$root/scripts/tasks/cert/health-cleanup"

printf 'check:full: PASS (manual Fedora VM/KVM certification remains explicit)\n'
