#!/usr/bin/env bash
set -euo pipefail

# This script is intentionally free of compilation and service work. Both
# canonical gates run it exactly once before selecting their test breadth.
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
cd "$root"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'check:shared: required command is missing: %s\n' "$1" >&2
        exit 1
    }
}

require_command bash
require_command python3

printf 'check:shared: shell syntax\n'
shopt -s nullglob
shell_scripts=(
    scripts/tasks/cert/*
    scripts/tasks/dev/smoke
    scripts/tasks/check/*
    scripts/mise/*
    .githooks/*
    scripts/install/*.sh
)
(( ${#shell_scripts[@]} >= 5 )) || {
    printf 'check:shared: expected repository shell scripts, found %s\n' "${#shell_scripts[@]}" >&2
    exit 1
}
for script in "${shell_scripts[@]}"; do
    [[ -f "$script" ]] && bash -n "$script"
done

printf 'check:shared: YAML syntax\n'
python3 - <<'PY'
import glob

try:
    import yaml
except ImportError as exc:
    raise SystemExit(f"check:shared: PyYAML is required for YAML validation: {exc}")

paths = sorted(glob.glob("ci/compose/*.yaml")) + sorted(glob.glob(".github/workflows/*.yml"))
if len(paths) < 6:
    raise SystemExit(f"check:shared: expected at least 6 YAML files, found {len(paths)}")
for path in paths:
    with open(path, encoding="utf-8") as stream:
        yaml.safe_load(stream)
    print(f"ok {path}")
PY

printf 'check:shared: complexity contract fixtures\n'
./scripts/tasks/complexity-setup-test
./scripts/tasks/complexity-gate-test
./scripts/tasks/complexity-soak-audit-test

printf 'check:shared: coverage contract fixtures\n'
./scripts/tasks/coverage-test
