#!/usr/bin/env python3
"""Run the pinned native complexity analyzers and normalize their reports.

This command is intentionally offline: setup acquires and verifies the native
binaries, while this command only executes binaries already present in the
cache. Missing tools, native parse errors, schema changes, and ambiguous source
identity fail closed rather than substituting an adapter-derived score.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

SCHEMA = 2
MANIFEST = Path("quality/complexity/tools.json")


def die(message: str) -> None:
    print(f"complexity-report: {message}", file=sys.stderr)
    raise SystemExit(2)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()


def schema_shape(value: Any, prefix: str = "$") -> list[str]:
    """Return a deterministic structural schema fingerprint for raw JSON."""
    if isinstance(value, dict):
        out = [f"{prefix}:object"]
        for key in sorted(value):
            out.extend(schema_shape(value[key], f"{prefix}.{key}"))
        return out
    if isinstance(value, list):
        out = [f"{prefix}:array"]
        if value:
            out.extend(schema_shape(value[0], f"{prefix}[]"))
        return out
    kind = "null" if value is None else "boolean" if isinstance(value, bool) else "number" if isinstance(value, (int, float)) else "string"
    return [f"{prefix}:{kind}"]


def native_schema(raw: Any) -> dict[str, Any]:
    shape = schema_shape(raw)
    return {"sha256": hashlib.sha256("\n".join(shape).encode()).hexdigest(), "paths": shape}


def source_files(root: Path, explicit: list[str]) -> list[Path]:
    if explicit:
        files = []
        for item in explicit:
            candidate = Path(item)
            path = (root / candidate if not candidate.is_absolute() else candidate).resolve()
            if path.suffix != ".rs":
                die(f"unsupported input (expected .rs): {path}")
            if not path.is_file():
                die(f"missing input: {path}")
            try:
                path.relative_to(root)
            except ValueError:
                die(f"input escapes source root: {path}")
            files.append(path)
        return sorted(set(files))
    base = root / "src"
    files = sorted(path for path in base.rglob("*.rs") if path.is_file()) if base.is_dir() else []
    if not files:
        die(f"no Rust input files under {base}")
    return files


def relative_path(path: str, root: Path) -> str:
    candidate = Path(path)
    if not candidate.is_absolute():
        candidate = (root / candidate).resolve()
    else:
        candidate = candidate.resolve()
    try:
        return candidate.relative_to(root).as_posix()
    except ValueError:
        die(f"native analyzer returned path outside source root: {path}")
    return ""


def source_classification(text: str) -> str:
    if re.search(r"(?im)^\s*(?://|/\*+|\*)\s*(?:@generated|generated file|autogenerated|do not edit)\b", text):
        return "generated"
    return "handwritten"


def module_name(path: str) -> str:
    bits = list(Path(path).with_suffix("").parts)
    if bits and bits[-1] == "mod":
        bits.pop()
    if bits and bits[-1] in ("lib", "main"):
        bits.pop()
    if bits and bits[0] == "src":
        bits.pop(0)
    return "crate" + ("::" + "::".join(bits) if bits else "")


def source_signature(text: str, line: int, name: str, kind: str) -> str:
    lines = text.splitlines()
    if line < 1 or line > len(lines):
        die(f"native row has unstable source location: line {line}")
    start = line - 1
    if kind != "closure" and name not in ("<anonymous>", ""):
        found = None
        for index in range(start, min(len(lines), start + 32)):
            if re.search(rf"\bfn\s+{re.escape(name)}\b", lines[index]):
                found = index
                break
        if found is None:
            die(f"native function {name!r} cannot be matched to source line {line}")
        start = found
        parts: list[str] = []
        for current in range(start, min(len(lines), start + 32)):
            parts.append(lines[current].strip())
            if "{" in lines[current] or ";" in lines[current]:
                break
        value = " ".join(parts).split("{", 1)[0].split(";", 1)[0].strip()
    else:
        value = lines[start].strip()
    value = re.sub(r"\s+", " ", value)
    if not value:
        die(f"native {kind} row at line {line} has no source signature")
    return value


def macro_info(text: str) -> dict[str, Any]:
    declarations = len(re.findall(r"\bmacro_rules!", text))
    invocations = len(re.findall(r"\b[A-Za-z_][A-Za-z0-9_]*!", text)) - declarations
    return {
        "declarations": max(0, declarations),
        "invocations": max(0, invocations),
        "expansion": "not_measured",
        "score_inclusion": "native_source_ast_only",
    }


def tool_binary(tool: str, root: Path, tool_root: Path) -> Path:
    if tool == "cccc":
        candidates = [tool_root / "cccc" / "cccc", tool_root / "cccc" / "cccc.exe"]
    else:
        candidates = [*tool_root.glob("big-code-analysis-*/bca"), *tool_root.glob("big-code-analysis/*/bca"), *tool_root.glob("big-code-analysis-*/bca.exe"), *tool_root.glob("big-code-analysis/*/bca.exe")]
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    die(f"verified {tool} binary is missing under {tool_root}; run scripts/tasks/complexity-setup")
    return Path()


def invoke(tool: str, binary: Path, root: Path, files: list[Path]) -> tuple[Any, list[str], str]:
    paths = [path.relative_to(root).as_posix() for path in files]
    if tool == "cccc":
        command = [str(binary), "--no-config", "--no-ignore", "--lang", "rust", *paths]
        output_path = None
    else:
        output_path = tempfile.NamedTemporaryFile(prefix="complexity-bca-", suffix=".json", delete=False)
        output_path.close()
        command = [str(binary), "metrics", "--format", "json", "--metrics", "cyclomatic,cognitive,sloc,ploc,lloc", "--no-config", "--no-ignore", "--no-skip-generated", "--output", output_path.name, *paths]
    env = {**os.environ, "LC_ALL": "C", "LANG": "C"}
    completed = subprocess.run(command, cwd=root, env=env, capture_output=True, text=True)
    if output_path is not None and completed.returncode != 0:
        Path(output_path.name).unlink(missing_ok=True)
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip()
        die(f"{tool} failed ({completed.returncode}): {detail}")
    try:
        if output_path is not None:
            raw_bytes = Path(output_path.name).read_bytes()
            Path(output_path.name).unlink(missing_ok=True)
            raw = json.loads(raw_bytes)
        else:
            raw_bytes = completed.stdout.encode()
            raw = json.loads(completed.stdout)
    except (OSError, json.JSONDecodeError) as exc:
        die(f"{tool} emitted invalid JSON: {exc}")
    return raw, command, hashlib.sha256(raw_bytes).hexdigest()


def validate_cccc(raw: Any) -> None:
    if not isinstance(raw, dict) or not isinstance(raw.get("files"), list) or not isinstance(raw.get("summary"), dict):
        die("cccc schema drift: expected object with files and summary")
    required_summary = {"file_count", "function_count", "parse_error_count", "parse_error_file_count", "cognitive", "cyclomatic"}
    if not required_summary <= raw["summary"].keys():
        die("cccc schema drift: summary fields changed")
    for file in raw["files"]:
        if not isinstance(file, dict) or not {"path", "functions", "cognitive", "cyclomatic"} <= file.keys():
            die("cccc schema drift: file fields changed")
        for row in file["functions"]:
            if not isinstance(row, dict) or not {"name", "kind", "line", "cognitive", "cyclomatic"} <= row.keys():
                die("cccc schema drift: function fields changed")


def validate_bca(raw: Any) -> None:
    if not isinstance(raw, list):
        die("big-code-analysis schema drift: expected an array of file spaces")
    for unit in raw:
        if not isinstance(unit, dict) or not {"name", "start_line", "end_line", "kind", "spaces", "metrics"} <= unit.keys():
            die("big-code-analysis schema drift: unit fields changed")
def flatten_cccc(files: list[dict[str, Any]], root: Path, texts: dict[str, str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    rows: list[dict[str, Any]] = []
    inventory: list[dict[str, Any]] = []
    seen: dict[tuple[str, str], int] = {}
    for file in files:
        path = relative_path(str(file["path"]), root)
        text = texts[path]
        cls = source_classification(text)
        info = {"path": path, "source_class": cls, "native": {"cognitive": file["cognitive"], "cyclomatic": file["cyclomatic"]}, "macro": macro_info(text)}
        parse_errors = file.get("parse_errors", [])
        if parse_errors:
            info["parse_errors"] = parse_errors
            die(f"native cccc parse failure in {path}: {'; '.join(parse_errors)}")
        inventory.append(info)

        def visit(native: dict[str, Any], parents: tuple[str, ...]) -> None:
            name = str(native["name"])
            kind = str(native["kind"])
            line = int(native["line"])
            identity_parts = (module_name(path), *parents, name)
            base_identity = "::".join(identity_parts)
            occurrence_key = (path, base_identity)
            occurrence = seen.get(occurrence_key, 0) + 1
            seen[occurrence_key] = occurrence
            identity = base_identity if occurrence == 1 else f"{base_identity}@{line}#{occurrence}"
            signature = source_signature(text, line, name, kind)
            row = {
                "identity": identity,
                "signature": signature,
                "path": path,
                "line": line,
                "kind": kind,
                "name": name,
                "cyclomatic": native["cyclomatic"],
                "cognitive": native["cognitive"],
                "native": {"analyzer": "cccc", "name": name, "kind": kind, "line": line, "cyclomatic": native["cyclomatic"], "cognitive": native["cognitive"]},
                "derived": {"identity": identity, "signature": signature, "path": path, "source_class": cls, "macro_expansion": "not_measured"},
                "source_class": cls,
            }
            rows.append(row)
            for child in native.get("children", []):
                visit(child, (*parents, name))

        for function in file["functions"]:
            visit(function, ())
    return rows, inventory


def flatten_bca(units: list[dict[str, Any]], root: Path, texts: dict[str, str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    rows: list[dict[str, Any]] = []
    inventory: list[dict[str, Any]] = []
    seen: dict[tuple[str, str], int] = {}
    for unit in units:
        path = relative_path(str(unit["name"]), root)
        text = texts[path]
        cls = source_classification(text)
        inventory.append({"path": path, "source_class": cls, "native": {"kind": unit["kind"]}, "macro": macro_info(text)})

        def visit(space: dict[str, Any], parents: tuple[str, ...]) -> None:
            name = str(space["name"])
            kind = str(space["kind"])
            line = int(space["start_line"])
            metrics = space.get("metrics") or {}
            cognitive = (metrics.get("cognitive") or {}).get("value")
            cyclomatic = (metrics.get("cyclomatic") or {}).get("value")
            if kind in ("function", "method") and not isinstance(cognitive, int):
                die(f"big-code-analysis missing cognitive metric for {path}:{line}")
            if kind in ("function", "method") and not isinstance(cyclomatic, int):
                die(f"big-code-analysis missing cyclomatic metric for {path}:{line}")
            base_identity = "::".join((module_name(path), *parents, name))
            occurrence_key = (path, base_identity)
            occurrence = seen.get(occurrence_key, 0) + 1
            seen[occurrence_key] = occurrence
            identity = base_identity if occurrence == 1 else f"{base_identity}@{line}#{occurrence}"
            if kind in ("function", "method"):
                signature = source_signature(text, line, name, "closure" if name == "<anonymous>" else kind)
                row = {
                    "identity": identity,
                    "signature": signature,
                    "path": path,
                    "line": line,
                    "kind": kind,
                    "name": name,
                    "cyclomatic": cyclomatic,
                    "cognitive": cognitive,
                    "native": {"analyzer": "big-code-analysis", "name": name, "kind": kind, "line": line, "cyclomatic": cyclomatic, "cognitive": cognitive},
                    "derived": {"identity": identity, "signature": signature, "path": path, "source_class": cls, "macro_expansion": "not_measured"},
                    "source_class": cls,
                }
                rows.append(row)
            for child in space.get("spaces", []):
                visit(child, (*parents, name))

        for space in unit.get("spaces", []):
            visit(space, ())
    return rows, inventory


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    project_default = Path(os.environ.get("MISE_PROJECT_ROOT", Path(__file__).resolve().parents[2]))
    parser.add_argument("--source-root", type=Path, default=project_default)
    parser.add_argument("--input", action="append", default=[], help="explicit .rs input; repeatable")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--schema", action="store_true", help="print report schema version and exit")
    args = parser.parse_args()
    if args.schema:
        print(SCHEMA)
        return 0
    project_root = project_default.resolve()
    root = args.source_root.resolve()
    if not root.is_dir():
        die(f"source root is not a directory: {root}")
    files = source_files(root, args.input)
    texts: dict[str, str] = {}
    for path in files:
        try:
            texts[path.relative_to(root).as_posix()] = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError) as exc:
            die(f"cannot read Rust input {path}: {exc}")
    manifest_path = project_root / MANIFEST
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read pinned tool manifest {manifest_path}: {exc}")
    tool_root = Path(os.environ.get("COMPLEXITY_TOOL_ROOT", str(project_root / ".cache" / "complexity-tools"))).resolve()
    candidates: dict[str, dict[str, Any]] = {}
    normalized: dict[str, tuple[list[dict[str, Any]], list[dict[str, Any]]]] = {}
    for tool in ("cccc", "big-code-analysis"):
        binary = tool_binary(tool, project_root, tool_root)
        expected_version = manifest["tools"][tool]["version"]
        version_run = subprocess.run([str(binary), "--version"], cwd=project_root, capture_output=True, text=True, check=False)
        version = version_run.stdout.strip() or version_run.stderr.strip()
        expected_output = f"cccc {expected_version}" if tool == "cccc" else f"bca {expected_version}"
        if version != expected_output:
            die(f"{tool} version mismatch: expected {expected_version}, got {version!r}")
        raw, command, raw_hash = invoke(tool, binary, root, files)
        if tool == "cccc":
            validate_cccc(raw)
        else:
            validate_bca(raw)
        expected_paths = {path.relative_to(root).as_posix() for path in files}
        observed_paths = ({relative_path(str(file["path"]), root) for file in raw["files"]} if tool == "cccc" else {relative_path(str(unit["name"]), root) for unit in raw})
        if observed_paths != expected_paths:
            die(f"{tool} did not return exactly one native report for every input (missing={sorted(expected_paths - observed_paths)}, unexpected={sorted(observed_paths - expected_paths)})")
        if tool == "cccc":
            fn_rows, file_rows = flatten_cccc(raw["files"], root, texts)
            parser_accounting = {"native_files": raw["summary"]["file_count"], "native_functions": raw["summary"]["function_count"], "parse_errors": raw["summary"]["parse_error_count"], "parse_error_files": raw["summary"].get("parse_error_files", [])}
            native_summary = raw["summary"]
        else:
            validate_bca(raw)
            fn_rows, file_rows = flatten_bca(raw, root, texts)
            parser_accounting = {"native_files": len(raw), "native_functions": len(fn_rows), "parse_errors": 0, "parse_error_files": [], "parse_error_note": "bca JSON has no parse-error field; empty spaces are retained as native output"}
            native_summary = None
        if parser_accounting["parse_errors"]:
            die(f"{tool} reported {parser_accounting['parse_errors']} native parse errors")
        normalized[tool] = (fn_rows, file_rows)
        display_command = list(command)
        if "--output" in display_command:
            output_index = display_command.index("--output") + 1
            display_command[output_index] = "native-output.json"
        candidates[tool] = {
            "version": expected_version,
            "executed": True,
            "execution": "native-binary",
            "binary": tool,
            "binary_sha256": sha256(binary),
            # Both native analyzers run with --no-config.  Recording this
            # identity prevents a local config file from silently changing the
            # metric contract between a baseline and a gate report.
            "config_identity": "no-config",
            "command": [tool, *display_command[1:]],
            "raw_stdout_sha256": raw_hash,
            "schema": native_schema(raw),
            "parser_accounting": parser_accounting,
            "native_summary": native_summary,
            "metrics": ["cyclomatic", "cognitive"] if tool == "cccc" else ["cyclomatic", "cognitive", "loc"],
        }
    primary = "cccc"
    primary_rows, primary_files = normalized[primary]
    primary_rows.sort(key=lambda row: (row["path"], row["line"], row["identity"], row["kind"]))
    primary_files.sort(key=lambda row: row["path"])
    if not any(row["source_class"] == "handwritten" for row in primary_files):
        die("source accounting found no handwritten files")
    canonical = {"functions": primary_rows, "files": primary_files}
    canonical_hash = hashlib.sha256(canonical_json(canonical)).hexdigest()
    comparison: dict[str, Any] = {}
    def grouped(rows: list[dict[str, Any]]) -> dict[tuple[str, int], list[dict[str, Any]]]:
        result: dict[tuple[str, int], list[dict[str, Any]]] = {}
        for row in rows:
            result.setdefault((row["path"], row["line"]), []).append(row)
        for values in result.values():
            values.sort(key=lambda row: (row["identity"], row["kind"]))
        return result

    base_keys = grouped(primary_rows)
    for tool, (rows, files_info) in normalized.items():
        rows.sort(key=lambda row: (row["path"], row["line"], row["identity"], row["kind"]))
        other = grouped(rows)
        common = sorted(set(base_keys) & set(other))
        discrepancies = []
        identity_differences = []
        for key in common:
            left_rows, right_rows = base_keys[key], other[key]
            if len(left_rows) != len(right_rows):
                discrepancies.append({"path": key[0], "line": key[1], "metric": "row_count", "cccc": len(left_rows), "candidate": len(right_rows)})
            for left, right in zip(left_rows, right_rows):
                if left["identity"] != right["identity"]:
                    identity_differences.append({"path": key[0], "line": key[1], "cccc": left["identity"], "candidate": right["identity"]})
                for metric in ("cyclomatic", "cognitive"):
                    if left[metric] != right[metric]:
                        discrepancies.append({"path": key[0], "line": key[1], "metric": metric, "cccc": left[metric], "candidate": right[metric]})
        comparison[tool] = {"files": len(files_info), "functions": len(rows), "common_functions": sum(min(len(base_keys[key]), len(other[key])) for key in common), "missing_from_candidate": [list(key) for key in sorted(set(base_keys) - set(other))], "missing_from_cccc": [list(key) for key in sorted(set(other) - set(base_keys))], "identity_differences": identity_differences, "metric_discrepancies": discrepancies}
    report = {
        "schema_version": SCHEMA,
        "mode": "offline-native",
        "selection": {"primary": primary, "fallback": "big-code-analysis", "reason": "cccc is MIT-licensed and its syn Rust adapter reports native closure/function boundaries and explicit parse errors; bca remains a pinned tree-sitter comparison with native LOC only"},
        "candidates": candidates,
        "source_accounting": {"files": len(primary_files), "handwritten": sum(row["source_class"] == "handwritten" for row in primary_files), "generated": sum(row["source_class"] == "generated" for row in primary_files), "parse_failures": 0, "functions": len(primary_rows)},
        "canonical_sha256": canonical_hash,
        "canonical": canonical,
        "comparison": comparison,
        "audit": {"schema_drift": False, "nondeterministic_output": False, "temporal_soak": "pending: requires 10 consecutive runs spanning 7 calendar days"},
    }
    encoded = json.dumps(report, sort_keys=True, indent=2, ensure_ascii=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(encoded, encoding="utf-8")
    else:
        sys.stdout.write(encoded)
    print(f"complexity report PASS: {len(primary_files)} files, {len(primary_rows)} functions, sha256={canonical_hash}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    main()
