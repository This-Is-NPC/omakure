#!/usr/bin/env python3
"""Generate canonical complexity evidence and enforce the CI ratchet."""

import argparse
import datetime
import json
import os
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
QUALITY = Path("target/quality")
EVIDENCE = QUALITY / "complexity-evidence"
REPORT_A = QUALITY / "complexity-report-a.json"
REPORT_B = QUALITY / "complexity-report-b.json"


def run(*args: str) -> None:
    subprocess.run(args, check=True)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("calibration", "trusted-soak"))
    args = parser.parse_args()
    os.chdir(ROOT)
    run("./scripts/tasks/complexity-setup")
    run("./scripts/tasks/complexity-test")
    if args.mode == "trusted-soak":
        run("./scripts/tasks/complexity-gate-test")
    EVIDENCE.mkdir(parents=True, exist_ok=True)

    report_command = "./scripts/tasks/complexity-report"
    run(report_command, "--source-root", ".", "--output", str(REPORT_A))
    run(report_command, "--source-root", ".", "--output", str(REPORT_B))
    run("cmp", "--silent", str(REPORT_A), str(REPORT_B))

    report = json.loads(REPORT_A.read_text())
    evidence = {
        "status": "success",
        "run_id": os.environ["GITHUB_RUN_ID"],
        "sequence": int(os.environ["GITHUB_RUN_NUMBER"]),
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "schema_version": report["schema_version"],
        "canonical_sha256": report["canonical_sha256"],
        "candidates": report["candidates"],
        "source_accounting": report["source_accounting"],
        "audit": report["audit"],
        "provenance": {
            "repository": os.environ["GITHUB_REPOSITORY"],
            "workflow": os.environ["GITHUB_WORKFLOW"],
            "event": os.environ["GITHUB_EVENT_NAME"],
            "ref": os.environ["GITHUB_REF"],
            "sha": os.environ["GITHUB_SHA"],
            "run_attempt": int(os.environ["GITHUB_RUN_ATTEMPT"]),
        },
    }
    if args.mode == "trusted-soak":
        corpus_path = QUALITY / "complexity-corpus.json"
        run(
            report_command,
            "--source-root",
            "quality/complexity/fixtures",
            "--input",
            "corpus.rs",
            "--output",
            str(corpus_path),
        )
        corpus = json.loads(corpus_path.read_text())
        analyzer_name = report["selection"]["primary"]
        analyzer = report["candidates"][analyzer_name]
        evidence["corpus_sha256"] = corpus["canonical_sha256"]
        evidence["tool"] = {
            "analyzer": analyzer_name,
            "version": analyzer["version"],
            "binary_sha256": analyzer["binary_sha256"],
            "config_identity": analyzer["config_identity"],
            "schema_sha256": analyzer["schema"]["sha256"],
        }
    (EVIDENCE / "run.json").write_text(json.dumps(evidence, sort_keys=True, indent=2) + "\n")

    run(
        "./scripts/tasks/complexity-gate",
        "--report",
        str(REPORT_A),
        "--repeat-report",
        str(REPORT_B),
        "--baseline",
        "quality/complexity/baseline.json",
        "--exceptions",
        "quality/complexity/exceptions.json",
        "--output",
        str(EVIDENCE / "gate.json"),
    )


if __name__ == "__main__":
    main()
